.jstv-source-card,.jstv-channel-card{background:#0c1420;border:1px solid #27334a;border-radius:14px;overflow:hidden;cursor:pointer;padding:10px}.jstv-source-card img,.jstv-channel-card img{width:100%;aspect-ratio:16/9;object-fit:cover;border-radius:10px;background:#05080d;display:block}.jstv-source-card b,.jstv-channel-card b{display:block;margin-top:8px}.jstv-source-card .muted,.jstv-channel-card .muted{margin-top:4px}.jstv-empty{padding:14px;border:1px dashed #33445a;border-radius:12px;color:#9aa9bb}.jstv-source-card.loading{opacity:.7}.admin-html-frame{width:100%;min-height:240px;border:0;border-radius:10px;background:#05080d}.admin-html-preview{margin-top:10px;border:1px solid #27334a;border-radius:12px;overflow:hidden;background:#080d14}.admin-html-meta{padding:9px 10px;background:#0d1622}.admin-html-meta b{display:block;font-size:16px}.admin-html-meta small{color:#91a0b2}.admin-html-poster{width:100%;aspect-ratio:16/9;object-fit:cover;display:block;background:#111927}
