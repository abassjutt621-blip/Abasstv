(function(){
 const DEFAULTS={nav_home:{label:'Home',icon:'⌂',image:'',link:'',enabled:true},nav_video_post:{label:'Video Post',icon:'🎬',image:'',link:'',enabled:true},nav_profile:{label:'Profile',icon:'👤',image:'',link:'',enabled:true},header_profile:{label:'Profile',icon:'👤',image:'',link:'',enabled:true},header_video_post:{label:'Post Video',icon:'🎬',image:'',link:'',enabled:true},profile_deposit:{label:'Deposit',icon:'💳',image:'',link:'',enabled:true},profile_withdraw:{label:'Withdraw',icon:'💸',image:'',link:'',enabled:true},manage_wallet:{label:'Manage Wallet',icon:'▣',image:'',link:'',enabled:true},withdrawal:{label:'Withdrawal',icon:'💸',image:'',link:'',enabled:true},vip:{label:'VIP',icon:'♛',image:'',link:'',enabled:true},records:{label:'My Records',icon:'▤',image:'',link:'',enabled:true},friend_list:{label:'Friend List',icon:'👥',image:'',link:'',enabled:true},invite_view:{label:'View',icon:'👁',image:'',link:'',enabled:true},menu_profile:{label:'Profile',icon:'●',image:'',link:'',enabled:true},security_center:{label:'Security Center',icon:'✓',image:'',link:'',enabled:true},find_us:{label:'Find us',icon:'⌖',image:'',link:'',enabled:true},language:{label:'Language',icon:'En',image:'',link:'',enabled:true}};
